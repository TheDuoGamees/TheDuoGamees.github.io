                    toastCharsetEmpty: 'Charset is empty! Select at least one option.',
                    toastGenerated: 'Generated {count} keys in {time}ms.',
                    toastPreview: 'Preview generated {count} keys.',
                    toastStopped: 'Generation stopped. {count} keys collected.',
                    toastFastMode: 'Fast mode uses Math.random – not suitable for production secrets.',
                    toastCopied: 'Copied!',
                    modalFastTitle: '⚠️ Fast Mode Warning',
