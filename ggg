<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API Key Generator</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js">
    </script>
    <style>
        :root {
            --bg: #0f1117;
            --surface: #1a1d27;
            --surface2: #22253a;
            --border: #2a2d3a;
            --text: #e1e3ec;
            --text2: #a0a4b8;
            --text3: #6b6f85;
            --accent: #6c8cff;
            --accent2: #4af0c9;
            --danger: #ff5e7a;
            --warning: #ffb347;
            --success: #4ade80;
            --shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
            --radius: 10px;
            --radius-sm: 6px;
            --transition: 0.2s ease;
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --glow: 0 0 18px rgba(108, 140, 255, 0.25);
            --glow-neon: 0 0 22px rgba(255, 0, 255, 0.5);
        }

        [data-theme="light"] {
            --bg: #f5f6fa;
            --surface: #ffffff;
            --surface2: #eef0f6;
            --border: #d5d8e2;
            --text: #1a1d2e;
            --text2: #555a72;
            --text3: #8b8fa8;
            --accent: #4f6ef6;
            --accent2: #0ea882;
            --danger: #e04868;
            --warning: #d98c20;
            --success: #2ca85e;
            --shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            --glow: 0 0 14px rgba(79, 110, 246, 0.18);
        }

        [data-theme="neon"] {
            --bg: #06060f;
            --surface: #0d0d20;
            --surface2: #14142e;
            --border: #2a1060;
            --text: #f0e6ff;
            --text2: #c4b5f7;
            --text3: #7b6aaa;
            --accent: #e040fb;
            --accent2: #00e5ff;
            --danger: #ff3c6a;
            --warning: #ffab00;
            --success: #00e676;
            --shadow: 0 2px 24px rgba(160, 40, 255, 0.3);
            --glow: 0 0 28px rgba(224, 64, 251, 0.45);
            --glow-neon: 0 0 32px rgba(0, 229, 255, 0.6);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            transition: background var(--transition), color var(--transition);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .app-container {
            max-width: 860px;
            margin: 0 auto;
            padding: 20px 16px 40px;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 16px 0 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 20px;
            transition: border-color var(--transition);
        }
        header h1 {
            font-size: 1.55rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 16px;
            border-radius: var(--radius-sm);
            border: 1px solid transparent;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all var(--transition);
            white-space: nowrap;
            letter-spacing: 0.01em;
            position: relative;
            overflow: hidden;
            user-select: none;
        }
        .btn:active {
            transform: scale(0.96);
        }
        .btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            pointer-events: none;
        }
        .btn-primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
            box-shadow: var(--glow);
        }
        .btn-primary:hover:not(:disabled) {
            filter: brightness(1.15);
            box-shadow: 0 0 24px rgba(108, 140, 255, 0.45);
        }
        .btn-outline {
            background: transparent;
            color: var(--text);
            border-color: var(--border);
        }
        .btn-outline:hover:not(:disabled) {
            background: var(--surface2);
            border-color: var(--accent);
        }
        .btn-danger {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }
        .btn-danger:hover:not(:disabled) {
            filter: brightness(1.2);
        }
        .btn-sm {
            padding: 5px 11px;
            font-size: 0.8rem;
            border-radius: 4px;
        }
        .btn-icon {
            padding: 8px 10px;
            min-width: 36px;
            justify-content: center;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: var(--shadow);
            transition: all var(--transition);
        }
        .card h3 {
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text2);
            margin-bottom: 14px;
            font-weight: 700;
        }

        .grid {
            display: grid;
            gap: 14px;
        }
        .grid-2 {
            grid-template-columns: 1fr 1fr;
        }
        .grid-3 {
            grid-template-columns: 1fr 1fr 1fr;
        }
        .grid-4 {
            grid-template-columns: 1fr 1fr 1fr 1fr;
        }
        @media (max-width: 680px) {
            .grid-2,
            .grid-3,
            .grid-4 {
                grid-template-columns: 1fr;
            }
            .app-container {
                padding: 10px 8px 32px;
            }
            header h1 {
                font-size: 1.25rem;
            }
            .btn {
                padding: 7px 12px;
                font-size: 0.82rem;
            }
        }

        label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text2);
            margin-bottom: 4px;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }
        input[type="text"],
        input[type="number"],
        select {
            width: 100%;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--surface2);
            color: var(--text);
            font-size: 0.9rem;
            font-family: var(--font);
            transition: all var(--transition);
            outline: none;
        }
        input:focus,
        select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(108, 140, 255, 0.12);
        }
        input[type="checkbox"] {
            accent-color: var(--accent);
            width: 17px;
            height: 17px;
            cursor: pointer;
            margin-right: 4px;
            vertical-align: middle;
        }
        .checkbox-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            text-transform: none;
            letter-spacing: 0;
            color: var(--text);
            font-weight: 500;
        }
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 16px;
            align-items: center;
        }

        .mode-switch {
            display: flex;
            gap: 0;
            border-radius: var(--radius-sm);
            overflow: hidden;
            border: 1px solid var(--border);
            width: fit-content;
        }
        .mode-switch button {
            padding: 8px 18px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--surface2);
            color: var(--text2);
            transition: all var(--transition);
            font-family: var(--font);
        }
        .mode-switch button.active {
            background: var(--accent);
            color: #fff;
        }
        .mode-switch button:not(.active):hover {
            background: var(--surface);
            color: var(--text);
        }

        .preview-area {
            max-height: 320px;
            overflow-y: auto;
            background: var(--surface2);
            border-radius: var(--radius-sm);
            padding: 12px 14px;
            font-family: 'SF Mono', 'Cascadia Code', 'Consolas', 'Monaco', monospace;
            font-size: 0.78rem;
            line-height: 1.7;
            word-break: break-all;
            color: var(--accent2);
            border: 1px solid var(--border);
            transition: all var(--transition);
            white-space: pre-wrap;
            min-height: 60px;
        }
        .preview-area:empty::after {
            content: attr(data-placeholder);
            color: var(--text3);
            font-style: italic;
        }

        .progress-bar-wrap {
            height: 6px;
            background: var(--surface2);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 10px;
            display: none;
        }
        .progress-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            border-radius: 10px;
            transition: width 0.15s ease;
        }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
            max-width: 380px;
        }
        .toast {
            pointer-events: auto;
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
            animation: slideInUp 0.3s ease, fadeOut 0.3s ease 2.7s forwards;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 0.01em;
        }
        .toast-success {
            background: #1a8a4a;
        }
        .toast-warning {
            background: #c47f1a;
        }
        .toast-error {
            background: #c0392b;
        }
        .toast-info {
            background: #2a5fad;
        }
        @keyframes slideInUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        @keyframes fadeOut {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
                transform: translateY(-8px);
            }
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.65);
            z-index: 8888;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }
        .modal-overlay.hidden {
            display: none;
        }
        .modal-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px 28px;
            max-width: 440px;
            width: 90%;
            box-shadow: var(--shadow), var(--glow);
            text-align: center;
        }
        .modal-box h3 {
            margin-bottom: 10px;
            font-size: 1.2rem;
        }
        .modal-box p {
            color: var(--text2);
            margin-bottom: 18px;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        .modal-box .btn {
            min-width: 90px;
        }
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .estimate-text {
            font-size: 0.78rem;
            color: var(--text3);
            margin-top: 4px;
            font-weight: 500;
        }

        .pulse {
            animation: pulse 1.2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%,
            100% {
                box-shadow: var(--glow);
            }
            50% {
                box-shadow: 0 0 30px rgba(108, 140, 255, 0.6);
            }
        }

        [data-theme="neon"] .card {
            box-shadow: 0 0 18px rgba(180, 60, 255, 0.2);
        }
        [data-theme="neon"] .btn-primary {
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
        }
        [data-theme="neon"] .preview-area {
            box-shadow: inset 0 0 14px rgba(0, 229, 255, 0.1);
        }
    </style>
</head>
<body data-theme="dark">

    <div class="app-container">
        <!-- HEADER -->
        <header>
            <h1>🔑 API Key Generator</h1>
            <div class="header-actions">
                <button class="btn btn-outline btn-sm" id="btnLang" title="Switch language">🌐 EN</button>
                <button class="btn btn-outline btn-sm" id="btnTheme" title="Switch theme">🎨 Theme</button>
            </div>
        </header>

        <!-- SETTINGS CARD -->
        <div class="card" id="settingsCard">
            <h3>⚙️ Generation Settings</h3>
            <div class="grid grid-2">
                <div>
                    <label>Mode</label>
                    <div class="mode-switch" id="modeSwitch">
                        <button data-mode="length" class="active">Length</button>
                        <button data-mode="bits">Bits</button>
                    </div>
                </div>
                <div id="lengthContainer">
                    <label for="inputLength">Key Length</label>
                    <input type="number" id="inputLength" value="32" min="4" max="4096" step="1">
                </div>
                <div id="bitsContainer" style="display:none;">
                    <label for="inputBits">Bits (64–2048)</label>
                    <input type="number" id="inputBits" value="256" min="64" max="2048" step="8">
                </div>
                <div>
                    <label for="inputPrefix">Custom Prefix</label>
                    <input type="text" id="inputPrefix" placeholder="e.g. myapp_" maxlength="32">
                </div>
                <div>
                    <label for="selectKeyType">Key Type</label>
                    <select id="selectKeyType">
                        <option value="api">api</option>
                        <option value="sk">sk</option>
                        <option value="pk">pk</option>
                    </select>
                </div>
                <div>
                    <label for="selectEnv">Environment</label>
                    <select id="selectEnv">
                        <option value="live">live</option>
                        <option value="test">test</option>
                    </select>
                </div>
                <div>
                    <label for="selectRandomMode">Random Mode</label>
                    <select id="selectRandomMode">
                        <option value="crypto">crypto (secure)</option>
                        <option value="fast">fast (Math.random)</option>
                    </select>
                </div>
                <div>
                    <label for="inputCount">Keys to Generate</label>
                    <input type="number" id="inputCount" value="100" min="1" max="500000" step="1">
                </div>
            </div>
            <div class="grid" style="margin-top:12px;">
                <div>
                    <label>Charset</label>
                    <div class="checkbox-group">
                        <span class="checkbox-label"><input type="checkbox" id="chkLetters" checked> Letters (A-Z, a-z)</span>
                        <span class="checkbox-label"><input type="checkbox" id="chkNumbers" checked> Numbers (0-9)</span>
                        <span class="checkbox-label"><input type="checkbox" id="chkSymbols"> Symbols</span>
                    </div>
                </div>
                <div>
                    <label for="inputCustomCharset">Custom Charset</label>
                    <input type="text" id="inputCustomCharset" placeholder="Additional characters..." maxlength="200">
                </div>
            </div>
            <div class="checkbox-group" style="margin-top:10px; gap:16px;">
                <span class="checkbox-label"><input type="checkbox" id="chkExcludeSimilar"> Exclude similar (0Ool1I)</span>
                <span class="checkbox-label"><input type="checkbox" id="chkSeparator"> Separator "-" every 4 chars</span>
            </div>
        </div>

        <!-- PREVIEW CARD -->
        <div class="card">
            <h3>👁️ Preview (50 keys)</h3>
            <div class="preview-area" id="previewArea" data-placeholder="Click &quot;Preview&quot; to see generated keys..."></div>
            <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
                <button class="btn btn-outline" id="btnPreview">🔍 Preview</button>
                <button class="btn btn-outline btn-sm" id="btnClearPreview">Clear</button>
            </div>
        </div>

        <!-- GENERATION CARD -->
        <div class="card">
            <h3>📦 Generate & Download</h3>
            <div class="grid grid-2" style="align-items:end;">
                <div>
                    <label for="selectFormat">File Format</label>
                    <select id="selectFormat">
                        <option value="txt">TXT</option>
                        <option value="csv">CSV</option>
                        <option value="json">JSON</option>
                        <option value="zip">ZIP (archive)</option>
                    </select>
                </div>
                <div style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
                    <button class="btn btn-primary" id="btnGenerate">⚡ Generate</button>
                    <button class="btn btn-danger" id="btnStop" disabled>⏹ Stop</button>
                </div>
            </div>
            <div class="progress-bar-wrap" id="progressWrap">
                <div class="progress-bar-fill" id="progressFill"></div>
            </div>
            <p class="estimate-text" id="estimateText"></p>
        </div>
    </div>

    <!-- TOAST CONTAINER -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- MODAL -->
    <div class="modal-overlay hidden" id="modalOverlay">
        <div class="modal-box">
            <h3 id="modalTitle">⚠️ Warning</h3>
            <p id="modalBody"></p>
            <button class="btn btn-primary" id="modalConfirm">OK</button>
        </div>
    </div>

    <script>
        (function() {
            // ==================== 1. STATE ====================
            const state = {
                mode: 'length', // 'length' | 'bits'
                length: 32,
                bits: 256,
                charsets: {
                    letters: true,
                    numbers: true,
                    symbols: false,
                    custom: ''
                },
                excludeSimilar: false,
                separator: false,
                prefix: '',
                keyType: 'api',
                env: 'live',
                randomMode: 'crypto',
                theme: 'dark',
                lang: 'en',
                count: 100,
                previewCount: 50,
                isGenerating: false,
                worker: null,
                collectedKeys: [],
                modalResolve: null,
                fastModeWarned: false,
            };

            // ==================== 2. DOM CACHE ====================
            const $ = (sel) => document.querySelector(sel);
            const $$ = (sel) => document.querySelectorAll(sel);

            const dom = {
                body: document.body,
                btnLang: $('#btnLang'),
                btnTheme: $('#btnTheme'),
                modeSwitch: $('#modeSwitch'),
                inputLength: $('#inputLength'),
                inputBits: $('#inputBits'),
                lengthContainer: $('#lengthContainer'),
                bitsContainer: $('#bitsContainer'),
                inputPrefix: $('#inputPrefix'),
                selectKeyType: $('#selectKeyType'),
                selectEnv: $('#selectEnv'),
                selectRandomMode: $('#selectRandomMode'),
                inputCount: $('#inputCount'),
                chkLetters: $('#chkLetters'),
                chkNumbers: $('#chkNumbers'),
                chkSymbols: $('#chkSymbols'),
                inputCustomCharset: $('#inputCustomCharset'),
                chkExcludeSimilar: $('#chkExcludeSimilar'),
                chkSeparator: $('#chkSeparator'),
                previewArea: $('#previewArea'),
                btnPreview: $('#btnPreview'),
                btnClearPreview: $('#btnClearPreview'),
                selectFormat: $('#selectFormat'),
                btnGenerate: $('#btnGenerate'),
                btnStop: $('#btnStop'),
                progressWrap: $('#progressWrap'),
                progressFill: $('#progressFill'),
                estimateText: $('#estimateText'),
                toastContainer: $('#toastContainer'),
                modalOverlay: $('#modalOverlay'),
                modalTitle: $('#modalTitle'),
                modalBody: $('#modalBody'),
                modalConfirm: $('#modalConfirm'),
            };

            // ==================== 3. I18N ====================
            const i18n = {
                en: {
                    title: 'API Key Generator',
                    settings: 'Generation Settings',
                    mode: 'Mode',
                    length: 'Key Length',
                    bits: 'Bits (64–2048)',
                    prefix: 'Custom Prefix',
