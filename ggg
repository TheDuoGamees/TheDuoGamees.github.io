                    modalFastTitle: '⚠️ Предупреждение',
                    modalFastBody: 'Быстрый режим использует Math.random, который НЕ является криптографически безопасным. Используйте только для тестов. Это предупреждение больше не появится.',
                    modalOk: 'OK',
                    bitsLabel: 'Биты',
                    lengthLabel: 'Длина',
                },
            };

            function t(key, vars) {
                let str = i18n[state.lang][key] || i18n['en'][key] || key;
                if (vars) {
                    for (const [k, v] of Object.entries(vars)) {
                        str = str.replace(`{${k}}`, v);
                    }
                }
                return str;
            }

            function updateAllLabels() {
                document.title = t('title');
                dom.btnLang.textContent = '🌐 ' + t('langBtn');
                dom.btnTheme.textContent = '🎨 ' + t('themeBtn');
                dom.previewArea.setAttribute('data-placeholder', t('previewPlaceholder'));
                dom.btnPreview.textContent = '🔍 ' + t('previewBtn');
                dom.btnClearPreview.textContent = t('clearPreview');
                dom.btnGenerate.textContent = '⚡ ' + t('generateBtn');
                dom.btnStop.textContent = '⏹ ' + t('stopBtn');
                dom.modalConfirm.textContent = t('modalOk');
                document.querySelector('#settingsCard h3').textContent = '⚙️ ' + t('settings');
                document.querySelectorAll('.card')[1].querySelector('h3').textContent = '👁️ ' + t('preview');
                document.querySelectorAll('.card')[2].querySelector('h3').textContent = '📦 ' + t(
                'generateDownload');
                updateEstimate();
            }

            // ==================== 4. HELPERS ====================
            const SIMILAR_CHARS = '0Ool1I';
            const SYMBOLS_CHARS = '!@#$%^&*()_+-=[]{}|;:,.<>?/~';
            const SEPARATOR_CHAR = '-';
            const SEPARATOR_EVERY = 4;

            function buildCharset() {
                let chars = '';
                if (state.charsets.letters) chars +=
                    'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
                if (state.charsets.numbers) chars += '0123456789';
                if (state.charsets.symbols) chars += SYMBOLS_CHARS;
                if (state.charsets.custom) chars += state.charsets.custom;
                if (state.excludeSimilar) {
                    chars = chars.split('').filter(c => !SIMILAR_CHARS.includes(c)).join('');
                }
                // Deduplicate
                chars = [...new Set(chars)].join('');
                return chars;
            }

            function getEffectiveLength() {
                if (state.mode === 'length') {
                    return Math.max(4, Math.min(4096, state.length));
                }
                const charset = buildCharset();
                if (!charset) return 32;
                const bitsPerChar = Math.log2(charset.length);
                const needed = Math.ceil(state.bits / bitsPerChar);
                return Math.max(4, Math.min(4096, needed));
            }

            function formatSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / 1048576).toFixed(2) + ' MB';
            }

            function estimateFileSize() {
                const charset = buildCharset();
                if (!charset) return '0 B';
                const effLen = getEffectiveLength();
                const prefixFull = buildFullPrefix();
                const keyLen = prefixFull.length + effLen + Math.floor(effLen / SEPARATOR_EVERY) * (state
                    .separator ? 1 : 0);
                const count = state.count;
                const format = dom.selectFormat.value;
                let bytes;
                switch (format) {
                    case 'json':
                        bytes = count * (keyLen + 4) + 4;
                        break;
                    case 'csv':
                    case 'txt':
                        bytes = count * (keyLen + 1);
                        break;
                    case 'zip':
                        bytes = count * (keyLen + 1) * 0.5;
                        break;
                    default:
                        bytes = count * (keyLen + 1);
                }
                return formatSize(Math.round(bytes));
            }

            function updateEstimate() {
                dom.estimateText.textContent = t('estimate') + ': ' + estimateFileSize();
            }

            function buildFullPrefix() {
                const p = state.prefix || '';
                const kt = state.keyType || 'api';
                const env = state.env || 'live';
                return p + kt + '_' + env + '_';
            }

            // ==================== 5. GENERATOR (Single Source) ====================
            function generateKey(config) {
                const {
                    charset,
                    effectiveLength,
                    separator,
                    prefixFull,
                    randomMode,
                } = config;

                if (!charset || charset.length === 0) return prefixFull + 'ERROR_EMPTY_CHARSET';

                const charsArr = charset.split('');
                const charCount = charsArr.length;
                const bodyChars = [];

                for (let i = 0; i < effectiveLength; i++) {
                    let idx;
                    if (randomMode === 'crypto') {
                        const arr = new Uint32Array(1);
                        crypto.getRandomValues(arr);
                        idx = arr[0] % charCount;
                    } else {
                        idx = Math.floor(Math.random() * charCount);
                    }
                    bodyChars.push(charsArr[idx]);
                }

                let body = '';
                if (separator) {
                    for (let i = 0; i < bodyChars.length; i++) {
                        if (i > 0 && i % SEPARATOR_EVERY === 0) {
                            body += SEPARATOR_CHAR;
                        }
                        body += bodyChars[i];
                    }
                } else {
                    body = bodyChars.join('');
                }

                return prefixFull + body;
            }

            function generateKeys(count, config) {
                const keys = [];
                for (let i = 0; i < count; i++) {
                    keys.push(generateKey(config));
                }
                return keys;
            }

            function buildGeneratorConfig() {
                return {
                    charset: buildCharset(),
                    effectiveLength: getEffectiveLength(),
                    separator: state.separator,
                    prefixFull: buildFullPrefix(),
                    randomMode: state.randomMode,
                };
            }

            // ==================== 6. WORKER ====================
            function createWorkerBlob() {
                const genKeyStr = generateKey.toString();
                const genKeysStr = generateKeys.toString();
                const workerCode = `
            const SIMILAR_CHARS = '0Ool1I';
            const SYMBOLS_CHARS = '!@#$%^&*()_+-=[]{}|;:,.<>?/~';
            const SEPARATOR_CHAR = '-';
            const SEPARATOR_EVERY = 4;

            ${genKeyStr}
            ${genKeysStr}

            self.onmessage = function(e) {
              const { config, count, chunkSize } = e.data;
              const keys = [];
              const totalChunks = Math.ceil(count / chunkSize);
              const startTime = performance.now();

              for (let chunk = 0; chunk < totalChunks; chunk++) {
                const start = chunk * chunkSize;
                const end = Math.min(start + chunkSize, count);
                const chunkKeys = [];
                for (let i = start; i < end; i++) {
                  chunkKeys.push(generateKey(config));
                }
                keys.push(...chunkKeys);
                const progress = Math.round(((chunk + 1) / totalChunks) * 100);
                self.postMessage({ type: 'chunk', keys: chunkKeys, progress, chunkIndex: chunk });
              }

              const totalTime = Math.round(performance.now() - startTime);
              self.postMessage({ type: 'complete', keys, totalTime });
            };
            `;
                return new Blob([workerCode], { type: 'application/javascript' });
            }

            function spawnWorker() {
                const blob = createWorkerBlob();
                const url = URL.createObjectURL(blob);
                const worker = new Worker(url);
                URL.revokeObjectURL(url);
                return worker;
            }

            function terminateWorker() {
                if (state.worker) {
                    state.worker.terminate();
                    state.worker = null;
                }
                state.isGenerating = false;
                dom.btnGenerate.disabled = false;
                dom.btnStop.disabled = true;
                dom.btnGenerate.classList.remove('pulse');
                dom.progressWrap.style.display = 'none';
                dom.progressFill.style.width = '0%';
            }

            function startGenerationInWorker(config, count, format) {
                terminateWorker();
                state.isGenerating = true;
                state.collectedKeys = [];
                dom.btnGenerate.disabled = true;
                dom.btnStop.disabled = false;
                dom.btnGenerate.classList.add('pulse');
                dom.progressWrap.style.display = 'block';
                dom.progressFill.style.width = '0%';

                const worker = spawnWorker();
                state.worker = worker;
                const chunkSize = Math.min(2000, Math.max(500, Math.floor(count / 20)));

                worker.onmessage = function(e) {
                    if (!state.isGenerating) return;
                    const msg = e.data;
                    if (msg.type === 'chunk') {
                        state.collectedKeys.push(...msg.keys);
                        dom.progressFill.style.width = msg.progress + '%';
                    } else if (msg.type === 'complete') {
                        state.collectedKeys = msg.keys;
                        dom.progressFill.style.width = '100%';
                        terminateWorker();
                        downloadKeys(state.collectedKeys, format, msg.totalTime);
                        notify('success', t('toastGenerated', { count: msg.keys.length, time: msg
                            .totalTime }));
                    }
                };

                worker.onerror = function(err) {
                    terminateWorker();
                    notify('error', 'Worker error: ' + err.message);
                };

                worker.postMessage({ config, count, chunkSize });
            }

            // ==================== 7. UI ====================
            function notify(type, message) {
                const toast = document.createElement('div');
                toast.className = 'toast toast-' + type;
                const icons = { success: '✅', warning: '⚠️', error: '❌', info: 'ℹ️' };
                toast.textContent = (icons[type] || '') + ' ' + message;
                dom.toastContainer.appendChild(toast);
                setTimeout(() => {
                    if (toast.parentNode) toast.remove();
                }, 3100);
            }

            function showModal(title, body) {
                return new Promise((resolve) => {
                    dom.modalTitle.textContent = title;
                    dom.modalBody.textContent = body;
                    dom.modalOverlay.classList.remove('hidden');
                    state.modalResolve = resolve;
                });
            }

            function hideModal() {
                dom.modalOverlay.classList.add('hidden');
                if (state.modalResolve) {
                    state.modalResolve(true);
                    state.modalResolve = null;
                }
            }

            dom.modalConfirm.addEventListener('click', hideModal);
            dom.modalOverlay.addEventListener('click', function(e) {
                if (e.target === dom.modalOverlay) hideModal();
            });

            function downloadKeys(keys, format, genTime) {
                if (!keys || keys.length === 0) {
                    notify('warning', 'No keys to download.');
                    return;
                }
                const count = keys.length;
                let blob, filename, mime;
                const prefix = 'keys_' + count;

                switch (format) {
                    case 'txt':
                        blob = new Blob([keys.join('\n')], { type: 'text/plain;charset=utf-8' });
                        filename = prefix + '.txt';
                        break;
                    case 'csv':
                        blob = new Blob([keys.join('\n')], { type: 'text/csv;charset=utf-8' });
                        filename = prefix + '.csv';
                        break;
                    case 'json':
                        blob = new Blob([JSON.stringify(keys, null, 2)], { type: 'application/json;charset=utf-8' });
                        filename = prefix + '.json';
                        break;
                    case 'zip':
                        if (typeof JSZip === 'undefined') {
                            notify('error', 'JSZip not loaded. Check your internet connection for CDN.');
                            return;
                        }
                        const zip = new JSZip();
                        zip.file(prefix + '.txt', keys.join('\n'));
                        zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } })
                            .then((zipBlob) => {
                                triggerDownload(zipBlob, prefix + '.zip');
                                notify('success', t('toastGenerated', { count, time: genTime || '?' }));
                            }).catch(err => {
                                notify('error', 'ZIP creation failed: ' + err.message);
                            });
                        return;
                    default:
                        blob = new Blob([keys.join('\n')], { type: 'text/plain;charset=utf-8' });
                        filename = prefix + '.txt';
                }

                triggerDownload(blob, filename);
            }

            function triggerDownload(blob, filename) {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(url), 5000);
            }

            function runPreview() {
                const config = buildGeneratorConfig();
                if (!config.charset) {
                    notify('error', t('toastCharsetEmpty'));
                    return;
                }
                const previewCount = Math.min(state.count, state.previewCount);
                const keys = generateKeys(previewCount, config);
                dom.previewArea.textContent = keys.join('\n');
                notify('info', t('toastPreview', { count: previewCount }));
            }

            function handleGenerate() {
                const config = buildGeneratorConfig();
                if (!config.charset) {
                    notify('error', t('toastCharsetEmpty'));
                    return;
                }
                const count = state.count;
                const format = dom.selectFormat.value;

                if (state.randomMode === 'fast' && !state.fastModeWarned) {
                    showModal(t('modalFastTitle'), t('modalFastBody')).then(() => {
                        state.fastModeWarned = true;
                        localStorage.setItem('fast_mode_warned', '1');
                        doGenerate(config, count, format);
                    });
                } else {
                    doGenerate(config, count, format);
                }
            }

            function doGenerate(config, count, format) {
                if (count <= 2000) {
                    const startTime = performance.now();
                    const keys = generateKeys(count, config);
                    const totalTime = Math.round(performance.now() - startTime);
                    downloadKeys(keys, format, totalTime);
                    notify('success', t('toastGenerated', { count, time: totalTime }));
                } else {
                    startGenerationInWorker(config, count, format);
                }
            }

            function handleStop() {
                if (state.isGenerating) {
                    const collected = state.collectedKeys.length;
                    terminateWorker();
                    notify('warning', t('toastStopped', { count: collected }));
                    if (collected > 0) {
                        const format = dom.selectFormat.value;
                        downloadKeys(state.collectedKeys.slice(), format, null);
                    }
                }
            }

            function applyTheme(theme) {
                state.theme = theme;
                dom.body.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
            }

            function cycleTheme() {
                const themes = ['dark', 'light', 'neon'];
                const idx = themes.indexOf(state.theme);
                const next = themes[(idx + 1) % themes.length];
                applyTheme(next);
            }

            function toggleLang() {
                state.lang = state.lang === 'en' ? 'ru' : 'en';
                localStorage.setItem('lang', state.lang);
                updateAllLabels();
            }

            function syncStateToDOM() {
                dom.inputLength.value = state.length;
                dom.inputBits.value = state.bits;
                dom.inputPrefix.value = state.prefix;
                dom.selectKeyType.value = state.keyType;
                dom.selectEnv.value = state.env;
                dom.selectRandomMode.value = state.randomMode;
                dom.inputCount.value = state.count;
                dom.chkLetters.checked = state.charsets.letters;
                dom.chkNumbers.checked = state.charsets.numbers;
                dom.chkSymbols.checked = state.charsets.symbols;
                dom.inputCustomCharset.value = state.charsets.custom;
                dom.chkExcludeSimilar.checked = state.excludeSimilar;
                dom.chkSeparator.checked = state.separator;
                dom.selectFormat.value = localStorage.getItem('format') || 'txt';

                if (state.mode === 'length') {
                    dom.lengthContainer.style.display = '';
                    dom.bitsContainer.style.display = 'none';
                    dom.modeSwitch.querySelector('[data-mode="length"]').classList.add('active');
                    dom.modeSwitch.querySelector('[data-mode="bits"]').classList.remove('active');
                } else {
                    dom.lengthContainer.style.display = 'none';
                    dom.bitsContainer.style.display = '';
                    dom.modeSwitch.querySelector('[data-mode="bits"]').classList.add('active');
                    dom.modeSwitch.querySelector('[data-mode="length"]').classList.remove('active');
                }
                applyTheme(state.theme);
                updateAllLabels();
            }

            function bindEvents() {
                dom.btnLang.addEventListener('click', toggleLang);
                dom.btnTheme.addEventListener('click', cycleTheme);

                dom.modeSwitch.addEventListener('click', function(e) {
                    const btn = e.target.closest('button');
                    if (!btn || !btn.dataset.mode) return;
                    state.mode = btn.dataset.mode;
                    syncStateToDOM();
                    saveSettings();
                });

                dom.inputLength.addEventListener('input', function() {
                    state.length = Math.max(4, Math.min(4096, parseInt(this.value) || 32));
                    this.value = state.length;
                    updateEstimate();
                    saveSettings();
                });
                dom.inputBits.addEventListener('input', function() {
                    state.bits = Math.max(64, Math.min(2048, parseInt(this.value) || 256));
                    this.value = state.bits;
                    updateEstimate();
                    saveSettings();
                });
                dom.inputPrefix.addEventListener('input', function() {
                    state.prefix = this.value;
                    updateEstimate();
                    saveSettings();
                });
                dom.selectKeyType.addEventListener('change', function() {
                    state.keyType = this.value;
                    updateEstimate();
                    saveSettings();
                });
                dom.selectEnv.addEventListener('change', function() {
                    state.env = this.value;
                    updateEstimate();
                    saveSettings();
                });
                dom.selectRandomMode.addEventListener('change', function() {
                    state.randomMode = this.value;
                    saveSettings();
                });
                dom.inputCount.addEventListener('input', function() {
                    state.count = Math.max(1, Math.min(500000, parseInt(this.value) || 100));
                    this.value = state.count;
                    updateEstimate();
                    saveSettings();
                });
                dom.chkLetters.addEventListener('change', function() {
                    state.charsets.letters = this.checked;
                    updateEstimate();
                    saveSettings();
                });
                dom.chkNumbers.addEventListener('change', function() {
                    state.charsets.numbers = this.checked;
                    updateEstimate();
                    saveSettings();
                });
                dom.chkSymbols.addEventListener('change', function() {
                    state.charsets.symbols = this.checked;
                    updateEstimate();
                    saveSettings();
                });
                dom.inputCustomCharset.addEventListener('input', function() {
                    state.charsets.custom = this.value;
                    updateEstimate();
                    saveSettings();
                });
                dom.chkExcludeSimilar.addEventListener('change', function() {
                    state.excludeSimilar = this.checked;
                    updateEstimate();
                    saveSettings();
                });
                dom.chkSeparator.addEventListener('change', function() {
                    state.separator = this.checked;
                    updateEstimate();
                    saveSettings();
                });
                dom.selectFormat.addEventListener('change', function() {
                    localStorage.setItem('format', this.value);
                    updateEstimate();
                });

                dom.btnPreview.addEventListener('click', runPreview);
                dom.btnClearPreview.addEventListener('click', function() {
                    dom.previewArea.textContent = '';
                });
                dom.btnGenerate.addEventListener('click', handleGenerate);
                dom.btnStop.addEventListener('click', handleStop);

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && state.isGenerating) {
                        handleStop();
                    }
                });
            }

            // ==================== 8. STORAGE ====================
            function saveSettings() {
                const data = {
                    mode: state.mode,
                    length: state.length,
                    bits: state.bits,
                    charsets: state.charsets,
                    excludeSimilar: state.excludeSimilar,
                    separator: state.separator,
                    prefix: state.prefix,
                    keyType: state.keyType,
                    env: state.env,
                    randomMode: state.randomMode,
                    count: state.count,
                    theme: state.theme,
                    lang: state.lang,
                    fastModeWarned: state.fastModeWarned,
                };
                try {
                    localStorage.setItem('apikeygen_settings', JSON.stringify(data));
                } catch (e) { /* storage full, ignore */ }
            }

            function loadSettings() {
                try {
                    const raw = localStorage.getItem('apikeygen_settings');
                    if (raw) {
                        const data = JSON.parse(raw);
                        if (data.mode === 'length' || data.mode === 'bits') state.mode = data.mode;
                        if (typeof data.length === 'number') state.length = data.length;
                        if (typeof data.bits === 'number') state.bits = data.bits;
                        if (data.charsets && typeof data.charsets === 'object') {
                            if (typeof data.charsets.letters === 'boolean') state.charsets.letters = data
                                .charsets.letters;
                            if (typeof data.charsets.numbers === 'boolean') state.charsets.numbers = data
                                .charsets.numbers;
                            if (typeof data.charsets.symbols === 'boolean') state.charsets.symbols = data
                                .charsets.symbols;
                            if (typeof data.charsets.custom === 'string') state.charsets.custom = data.charsets
                                .custom;
                        }
                        if (typeof data.excludeSimilar === 'boolean') state.excludeSimilar = data.excludeSimilar;
                        if (typeof data.separator === 'boolean') state.separator = data.separator;
                        if (typeof data.prefix === 'string') state.prefix = data.prefix;
                        if (['api', 'sk', 'pk'].includes(data.keyType)) state.keyType = data.keyType;
                        if (['live', 'test'].includes(data.env)) state.env = data.env;
                        if (['crypto', 'fast'].includes(data.randomMode)) state.randomMode = data.randomMode;
                        if (typeof data.count === 'number') state.count = data.count;
                        if (['dark', 'light', 'neon'].includes(data.theme)) state.theme = data.theme;
                        if (['en', 'ru'].includes(data.lang)) state.lang = data.lang;
                        if (typeof data.fastModeWarned === 'boolean') state.fastModeWarned = data.fastModeWarned;
                    }
                } catch (e) { /* ignore corrupt data */ }
                // Also load fast_mode_warned from separate key (legacy)
                if (localStorage.getItem('fast_mode_warned') === '1') {
                    state.fastModeWarned = true;
                }
                // Load format
                const fmt = localStorage.getItem('format');
                if (fmt && ['txt', 'csv', 'json', 'zip'].includes(fmt)) {
                    dom.selectFormat.value = fmt;
                }
            }

            // ==================== INIT ====================
            function init() {
                loadSettings();
                syncStateToDOM();
                bindEvents();
                updateEstimate();
                // If fast mode was already warned, keep it in state
                if (state.fastModeWarned) {
                    localStorage.setItem('fast_mode_warned', '1');
                }
            }

            // Run
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
</body>
